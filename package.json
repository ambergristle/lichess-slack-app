{
  "name": "lichess-slack-app",
  "version": "1.0.0",
  "description": "Slack integration for Lichess Daily Puzzles",
  "keywords": [
    "daily puzzles",
    "lichess",
    "node",
    "slack"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "ambergristle",
  "type": "module",
  "main": "dist/index.js",
  "module": "index.ts",
  "scripts": {
    "dev": "bun --bun --hot run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=bun",
    "start": "bun run dist/index.js",
    "lint": "oxlint",
    "lint:fix": "bun run lint --fix",
    "fmt": "oxfmt --check",
    "fmt:check": "oxfmt",
    "db:push": "bunx --bun drizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:setup": "bun run db:touch && bun run db:generate && bun run db:migrate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@date-fns/utc": "^2.1.0",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "hono": "^4.6.15",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@slack/web-api": "^6.9.0",
    "@types/bun": "^1.3.12",
    "@types/jsonwebtoken": "^9.0.6",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.2",
    "globals": "^15.14.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  }
}