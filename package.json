{
  "name": "lichess-slack-app",
  "type": "module",
  "version": "1.0.0",
  "author": "ambergristle",
  "license": "AGPL-3.0-or-later",
  "description": "Slack integration for Lichess Daily Puzzles",
  "keywords": [
    "lichess",
    "slack",
    "node",
    "daily puzzles"
  ],
  "module": "index.ts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --bun --hot run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=bun",
    "start": "bun run dist/index.js",
    "lint": "bun run eslint ./src",
    "lint:fix": "bun run lint --fix"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.1.8",
    "date-fns": "2.0.0",
    "date-fns-tz": "2.0.0",
    "hono": "^4.6.15",
    "jsonwebtoken": "^9.0.2",
    "pug": "^3.0.2",
    "wretch": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@slack/web-api": "^6.9.0",
    "@types/bun": "^1.1.16",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pug": "^2.0.10",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.20.0"
  }
}
