{
  "name": "lichess-slack-app",
  "type": "module",
  "version": "1.0.0",
  "author": "ambergristle",
  "license": "AGPL-3.0-or-later",
  "description": "Slack integration for Lichess Daily Puzzles",
  "keywords": [
    "lichess",
    "slack",
    "node",
    "daily puzzles"
  ],
  "module": "index.ts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --bun --hot run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=bun",
    "start": "bun run dist/index.js",
    "lint": "bun run eslint ./src",
    "lint:fix": "bun run lint --fix",
    "db:push": "bunx --bun drizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:setup": "bun run db:touch && bun run db:generate && bun run db:migrate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@date-fns/utc": "^2.1.0",
    "@hono/zod-validator": "^0.1.8",
    "@libsql/client": "^0.14.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.4",
    "drizzle-zod": "^0.6.1",
    "hono": "^4.6.15",
    "jsonwebtoken": "^9.0.2",
    "wretch": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@slack/web-api": "^6.9.0",
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@types/bun": "^1.1.16",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pug": "^2.0.10",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.20.0"
  }
}
